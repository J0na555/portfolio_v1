---
import TerminalExplorer from "../React/TerminalExplorer";

interface ProjectManifest {
  service: string;
  runtime: string;
  database: string;
  architecture: string;
  status: string;
  description: string;
  github: string;
  preview: string;
}

const projects: ProjectManifest[] = [
  {
    service: "Otaku Paradise",
    runtime: "Django REST Framework",
    database: "sqlite3",
    architecture: "Monolithic with Edge Caching",
    status: "In Development",
    description:
      "Full-stack anime streaming platform with complex many-to-many relationship mapping for metadata, user authentication via JWT, and real-time recommendation engine.",
    github: "https://github.com/J0na555/OtakuParadise",
    preview: "https://otakuparadise-6vx7.onrender.com/",
  },
  {
    service: "Anime Wrapped ",
    runtime: "FastAPI + React + Framer Motion",
    database: "Jikan API (MyAnimeList)",
    architecture: "RESTful API + Frontend",
    status: "Deployed",
    description:
      "A fun, personal 'Spotify Wrapped'-style year-end recap for your 2025 anime watching habits! Features autocomplete search, animated slideshow with stats, personality insights, and anime posters from MyAnimeList.",
    github: "https://github.com/J0na555/anime_wrap",
    preview: "https://anime-wrap-six.vercel.app/",
  },
  {
    service: "Commit Crystal Ball",
    runtime: "Python CLI Application",
    database: "None (Git-based file analysis)",
    architecture: "Local CLI tool with static analysis pipeline",
    status: "Active Development",
    description:
    "A command-line tool that analyzes staged Git changes before committing and predicts potential issues such as incomplete code, risky modifications, poor commit practices, or accidental debug artifacts. It acts as a pre-commit reflection tool for developers by reviewing staged files and generating warnings or insights to improve commit quality.",
    github: "https://github.com/J0na555/commit-crystal-ball",
    preview: "https://github.com/J0na555/commit-crystal-ball/blob/main/README.md",
  },
  {
    service: "Resona",
    runtime: "Python Application",
    database: "Local storage / lightweight persistence",
    architecture: "Modular service architecture",
    status: "In Development",
    description:
      "A productivity-focused developer tool designed to help programmers track, analyze, and improve their workflow. The system focuses on organizing coding activities, providing insights into developer habits, and helping maintain consistent productivity through structured tracking and analytics.",

    github: "https://github.com/J0na555/Resona",
    preview: "https://github.com/J0na555/Resona"
  },
  {
    service: "Type Storm",
    runtime: "Python + Pygame",
    database: "None (local runtime application)",
    architecture: "Event-driven game loop architecture",
    status: "Completed",
    description:
      "An interactive typing practice game designed for developers to improve typing speed and accuracy while working with code-like text patterns. Built using Python and Pygame, the application provides real-time feedback on typing performance, tracks speed and accuracy, and gamifies typing practice through engaging mechanics.",
    github: "https://github.com/J0na555/TypeStorm",
    preview: "https://github.com/J0na555/TypeStorm/blob/main/README.md"
  },
  {
    service: "MarkSub",
    runtime: "Django + REST API",
    database: "PostgreSQL",
    architecture: "MVC with API Gateway",
    status: "Deployed",
    description:
      "Subscription management system with automated billing cycles, webhook integrations for payment processing, and role-based access control.",
    github: "https://github.com/J0na555/markSub",
    preview: "https://smart-ybec.onrender.com/",
  },
  {
    service: "SMART",
    runtime: "Spring Boot + Microservices",
    database: "PostgreSQL",
    architecture: "Service-Oriented Architecture",
    status: "Deployed",
    description:
      "Student management and resource tracking system with RESTful API design, transaction management, and data validation layers.",
    github: "https://github.com/J0na555/SMART",
    preview: "https://smart-ybec.onrender.com/",
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Projects</h3>

    <TerminalExplorer projects={projects} client:load />

    <a
      target="_blank"
      href="https://github.com/J0na555?tab=repositories"
      aria-label="GitHub"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105"
    >
      <span class="md:text-lg text-md">More projects on</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path
          d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
        ></path>
      </svg>
    </a>
  </div>
</section>
